<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes: o que antes ficava na tela inicial comprida. O topo (‹ Ajustes) entra pelo código. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/coluna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Meu perfil" />

        <RadioGroup
            android:id="@+id/perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/perfilTaxi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Taxista" />

            <RadioButton android:id="@+id/perfilApp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Motorista de app" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/soTaxi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taxímetro" />

            <TextView android:id="@+id/cidadeAtual" style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <Button android:id="@+id/trocarTabela" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ver ou corrigir a tabela, trocar de cidade" />

            <RadioGroup
                android:id="@+id/categoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/comum" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Comum" />

                <RadioButton android:id="@+id/luxo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Luxo" />
            </RadioGroup>

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quando fica verde ou amarelo" />

            <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O número grande do aviso é quanto a oferta paga perto do que o taxímetro daria. Abaixo do amarelo, fica vermelho." />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verde a partir de (% do taxímetro)" />

            <EditText android:id="@+id/limiteVerde" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amarelo a partir de (% do taxímetro)" />

            <EditText android:id="@+id/limiteAmarelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/soApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quando fica verde ou amarelo" />

            <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O número grande do aviso é quanto a oferta paga por km, somando a busca e a viagem. Cada grupo de categoria tem o seu mínimo. Abaixo do amarelo, fica vermelho." />

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Econômico (UberX, 99Pop)" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verde a partir de (R$/km)" />

            <EditText android:id="@+id/verdeEconomico" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amarelo a partir de (R$/km)" />

            <EditText android:id="@+id/amareloEconomico" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conforto (Comfort, 99Plus)" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verde a partir de (R$/km)" />

            <EditText android:id="@+id/verdeConforto" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amarelo a partir de (R$/km)" />

            <EditText android:id="@+id/amareloConforto" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

            <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Premium (Black)" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verde a partir de (R$/km)" />

            <EditText android:id="@+id/verdePremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

            <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amarelo a partir de (R$/km)" />

            <EditText android:id="@+id/amareloPremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Busca maior que (km) baixa uma cor" />

        <EditText android:id="@+id/buscaMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avisos na oferta" />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avisar nota do passageiro abaixo de" />

        <EditText android:id="@+id/notaMinima" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avisar viagem longa acima de (km)" />

        <EditText android:id="@+id/viagemLonga" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <CheckBox android:id="@+id/aviso99" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mostrar o aviso também nas ofertas da 99" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A 99 não deixa ler o texto da oferta: o app tira uma foto da tela só quando ela chega, lê o valor e os km e apaga a foto na hora. Na 99 o valor pode subir no fim da corrida (taxímetro, trânsito, pedágio), então o aviso mostra o mínimo. Precisa do Android 11 ou mais novo." />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Onde o aviso aparece" />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lado da tela" />

        <RadioGroup
            android:id="@+id/ladoAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/ladoEsquerda" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Esquerda" />

            <RadioButton android:id="@+id/ladoCentro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Centro" />

            <RadioButton android:id="@+id/ladoDireita" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Direita" />
        </RadioGroup>

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ao escolher, aparece um aviso de teste no lugar novo." />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distância do aviso até o topo da tela" />

        <EditText android:id="@+id/posicaoY" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Número maior = aviso mais para baixo. Teste para ver se ficou em cima de alguma coisa." />

        <Button android:id="@+id/testar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Testar o aviso" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aba da Última oferta" />

        <RadioGroup
            android:id="@+id/abaTamanho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/abaLarga" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Larga" />

            <RadioButton android:id="@+id/abaMedia" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Média" />

            <RadioButton android:id="@+id/abaFina" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fina" />
        </RadioGroup>

        <TextView android:id="@+id/abaTransparenciaTexto" style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <SeekBar android:id="@+id/abaTransparencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="12" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quanto mais fina ou transparente, mais dá para ler o que está atrás, e mais difícil fica enxergar a aba. Para mudar a altura, segure a aba em cima da Uber ou da 99 e arraste." />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tablet / tela dividida" />

        <CheckBox android:id="@+id/telaDividida" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uso a Uber e a 99 com a tela dividida" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Para tablet (ou celular com a tela dividida). Cada app é lido no seu pedaço da tela e ganha o próprio aviso em cima dele: se a Uber e a 99 tocarem juntas, aparecem os dois avisos. Com um app só na tela, o aviso fica onde está marcado acima. No celular comum, deixe desmarcado." />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Embarque em mercado" />

        <CheckBox android:id="@+id/alertaMercado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avisar quando o embarque for em mercado" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aparece uma linha no aviso da oferta, sem mudar a cor. Só funciona quando a Uber ou a 99 escrevem o nome do lugar no endereço. Já vêm Atacadão, Assaí, Carrefour, Makro, Roldão, Sam\'s Club, Pão de Açúcar, Andorinha Hiper, Giga Atacadista, Rede Plus, Cobal e o que tiver supermercado, hipermercado ou atacado no nome." />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mercados do seu bairro (separe por vírgula)" />

        <EditText android:id="@+id/mercadosProprios" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:hint="Ex.: Empório do Zé, Sacolão Central" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alerta de radar" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Funciona só navegando pelo Waze ou pela 99: quando eles avisam de um radar, a tela ganha uma borda amarela e aparece a placa do limite com a distância. No Google Maps e na navegação da Uber não funciona, porque eles não escrevem a distância até o radar." />

        <CheckBox android:id="@+id/radar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mostrar alerta de radar" />

        <CheckBox android:id="@+id/radarSom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tocar som (três batidinhas)" />

        <Button android:id="@+id/testarRadar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Testar alerta de radar" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indo pra casa" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No fim do dia, ligue o Indo pra casa no Meu dia ou na notificação. Quando a corrida termina perto da sua casa, o aviso mostra 🏠 Perto de casa, em verde. Para calcular, o endereço do destino é consultado no mapa do Google pela internet. Desliga sozinho no dia seguinte." />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Endereço de casa" />

        <EditText android:id="@+id/casaEndereco" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Rua, número e bairro" android:inputType="textPostalAddress" />

        <TextView style="@style/Rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perto de casa é até (km)" />

        <EditText android:id="@+id/raioCasa" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <Button android:id="@+id/salvarCasa" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Salvar casa" />

        <TextView android:id="@+id/casaStatus" style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Botão de falar" />

        <CheckBox android:id="@+id/bolinha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bolinha Falar em cima da Uber e da 99" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uma bolinha verde com o microfone, como a da 99: um toque e você fala um ganho ou gasto sem sair da Uber ou da 99. Arraste para onde quiser; ela gruda na borda. Não aparece no Waze, para não atrapalhar a navegação. Para tirar, arraste até o X embaixo da tela ou desmarque aqui." />

        <TextView android:id="@+id/gravarTitulo" style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gravação da corrida" />

        <CheckBox android:id="@+id/gravar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Botão Gravar corrida na notificação" />

        <TextView android:id="@+id/gravarApoio" style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use só no táxi de rua, de ponto ou em corrida particular. Em corrida da Uber ou da 99, não use: a câmera fica ocupada e a gravação do próprio app pode falhar, e é ela que defende você numa reclamação. Grava em 480p (uns 300 MB por hora) na pasta Movies/Corrida Verde; passando de 5 GB, apaga os vídeos mais antigos, menos os que você guardou (ao parar, toque em Guardar este vídeo). Nunca começa nem para sozinha: se ficar ligada muito tempo, ou se chegar oferta da Uber ou da 99, o app avisa com som para você parar." />

        <Button android:id="@+id/salvar" style="@style/Botao.Principal" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="28dp" android:text="Salvar ajustes" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:text="Cópia dos seus dados" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ganhos, gastos, recibos, assinatura e ajustes ficam só neste celular. O backup do Google guarda uma cópia sozinho uma vez por dia, mas vale guardar a sua também: no Google Drive, no WhatsApp ou no e-mail. No celular novo, toque em Restaurar e escolha o arquivo." />

        <Button android:id="@+id/guardarCopia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Guardar uma cópia (Drive ou celular)" />

        <Button android:id="@+id/enviarCopia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mandar a cópia por WhatsApp ou e-mail" />

        <Button android:id="@+id/restaurarCopia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Restaurar de uma cópia" />

        <TextView style="@style/Secao" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:text="Avançado" />

        <Button android:id="@+id/ativar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Abrir a tela de Acessibilidade" />

        <CheckBox android:id="@+id/diagnostico" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Modo diagnóstico (guarda os textos lidos)" />

        <TextView style="@style/Apoio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Só ligue quando o suporte pedir: ele junta o que o app leu da tela para achar um problema. Desliga sozinho 24 horas depois de ligado." />

        <Button android:id="@+id/compartilhar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enviar diagnóstico" />

        <Button android:id="@+id/limparDiagnostico" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Limpar diagnóstico" />

        <TextView
            android:id="@+id/textoDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/texto2"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
