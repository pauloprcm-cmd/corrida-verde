<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Corrida Verde"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Compara a oferta da Uber com o taxímetro de SP. Só lê a tela: nunca toca, nunca aceita nem recusa." />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <Button
            android:id="@+id/ativar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar leitura (Acessibilidade)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Se o Android bloquear: Configurações › Apps › Corrida Verde › ⋮ › Permitir configurações restritas."
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tabela do taxímetro"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/comum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comum" />

            <RadioButton
                android:id="@+id/luxo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Luxo" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Verde a partir de (% do taxímetro)" />

        <EditText
            android:id="@+id/limiteVerde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amarelo a partir de (% do taxímetro)" />

        <EditText
            android:id="@+id/limiteAmarelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Busca acima de (km) rebaixa um nível" />

        <EditText
            android:id="@+id/buscaMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avisar nota do passageiro abaixo de" />

        <EditText
            android:id="@+id/notaMinima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avisar viagem longa acima de (km)" />

        <EditText
            android:id="@+id/viagemLonga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distância do popup ao topo da tela (dp)" />

        <EditText
            android:id="@+id/posicaoY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/diagnostico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo diagnóstico (guarda os textos lidos)" />

        <CheckBox
            android:id="@+id/gravar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar o botão Gravar corrida na notificação" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grava em 480p, uns 300 MB por hora, na pasta Movies/Corrida Verde. Passando de 5 GB, apaga os vídeos mais antigos. Nunca começa sozinho: você começa e para pelo botão da notificação. Enquanto grava, a câmera fica ocupada e a gravação da própria Uber pode não funcionar, então use só quando precisar."
            android:textSize="13sp" />

        <Button
            android:id="@+id/salvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Salvar" />

        <Button
            android:id="@+id/testar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testar popup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Alerta de radar"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quando o Waze ou a 99 avisam de um radar, a tela ganha uma borda amarela e aparece a placa do limite com a distância. No Google Maps e na navegação da Uber o radar é só um desenho no mapa, sem texto, e o app ainda não consegue ler."
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/radar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar alerta de radar" />

        <CheckBox
            android:id="@+id/radarSom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tocar som baixo (três batidinhas) no radar novo" />

        <Button
            android:id="@+id/testarRadar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testar alerta de radar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ganhos e gastos"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Os ganhos entram sozinhos: cada corrida soma o valor da oferta quando o passageiro embarca (Encerrar na Uber, Finalizar corrida na 99). Ao ficar offline, o Resumo da sessão da Uber troca essas corridas pelo valor oficial. Para os gastos, com a leitura ligada, desça a barra do topo e toque em Registrar gasto na notificação do Corrida Verde. Ex.: “abasteci 120 reais de etanol, 22 litros, tanque cheio, quilometragem 45.320”."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gastosHoje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/registrarGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar gasto por voz" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Última leitura (diagnóstico)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/compartilhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar diagnóstico" />
    </LinearLayout>
</ScrollView>
