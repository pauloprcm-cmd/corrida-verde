<?xml version="1.0" encoding="utf-8"?>
<!-- O mesmo que regras_backup.xml, para Android 12 ou mais novo (backup na nuvem e passagem direta
     de um celular para o outro). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostico.txt" />
        <exclude domain="file" path="status.txt" />
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="inicio.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diagnostico.txt" />
        <exclude domain="file" path="status.txt" />
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="inicio.xml" />
    </device-transfer>
</data-extraction-rules>
