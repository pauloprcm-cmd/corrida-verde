<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro das telas novas (início, Meu dia, Ajustes, Ajuda, Verificar problemas). -->
    <style name="Tema.Escuro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:colorPrimary">@color/fundo</item>
        <item name="android:colorPrimaryDark">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:colorAccent">@color/verde</item>
        <item name="android:colorControlNormal">@color/texto2</item>
        <item name="android:colorControlActivated">@color/verde</item>
        <item name="android:colorControlHighlight">@color/toque</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto2</item>
        <item name="android:textColorHint">@color/texto2</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textViewStyle">@style/Texto</item>
        <item name="android:buttonStyle">@style/Botao</item>
        <item name="android:checkboxStyle">@style/Caixa</item>
        <item name="android:radioButtonStyle">@style/Opcao</item>
        <item name="android:editTextStyle">@style/Campo</item>
        <item name="android:alertDialogTheme">@style/Dialogo</item>
    </style>

    <style name="Texto" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Botões grandes, de 68 dp, para o dedo acertar com o carro parado no ponto. -->
    <style name="Botao" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:background">@drawable/fundo_botao</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Botao.Principal">
        <item name="android:textColor">@color/fundo</item>
        <item name="android:background">@drawable/fundo_botao_principal</item>
    </style>

    <style name="Caixa" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="Opcao" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="Campo" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto2</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/fundo_campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Dialogo" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fundo_dialogo</item>
        <item name="android:colorAccent">@color/verde</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>

    <!-- Títulos e textos de apoio do layout de Ajustes. -->
    <style name="Secao" parent="Texto">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Rotulo" parent="Texto">
        <item name="android:textSize">17sp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Apoio" parent="Texto">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto2</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
