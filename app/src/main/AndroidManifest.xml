<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Só no botão "📍 Aqui" do recibo, um toque por vez. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Verificar problemas: saber se o app da Uber e o reconhecimento de voz existem no celular (Android 11+). -->
    <queries>
        <package android:name="com.ubercab.driver" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/regras_extracao"
        android:fullBackupContent="@xml/regras_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="Corrida Verde"
        android:theme="@android:style/Theme.Material.Light">

        <!-- Leitor de texto (OCR) da oferta da 99: o Google Play baixa uma vez só, fora do APK. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- Tela inicial: LIGADO/DESLIGADO, quanto sobrou hoje e os quatro botões. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Tema.Escuro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MeuDiaActivity"
            android:exported="false"
            android:label="Meu dia"
            android:theme="@style/Tema.Escuro" />

        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:label="Ajustes"
            android:theme="@style/Tema.Escuro"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AjudaActivity"
            android:exported="false"
            android:label="Ajuda"
            android:theme="@style/Tema.Escuro" />

        <activity
            android:name=".VerificarActivity"
            android:exported="false"
            android:label="Verificar problemas"
            android:theme="@style/Tema.Escuro" />

        <!-- Meu dinheiro: quanto sobrou no dia, na semana e no mês. -->
        <activity
            android:name=".DinheiroActivity"
            android:exported="false"
            android:label="Meu dinheiro" />

        <!-- Aberta pelo botão "Registrar por voz" da notificação, por cima do que estiver na tela. -->
        <activity
            android:name=".GastoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Abre e fecha na hora: só existe para a gravação poder ligar a câmera. -->
        <activity
            android:name=".GravarActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".GravacaoService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name=".LeitorService"
            android:exported="false"
            android:label="Corrida Verde"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/leitor" />
        </service>

        <!-- Recibo para o passageiro de rua, de ponto ou particular. -->
        <activity
            android:name=".ReciboActivity"
            android:exported="false"
            android:label="Recibo" />

        <activity
            android:name=".PersonalizarReciboActivity"
            android:exported="false"
            android:label="Personalizar recibo" />

        <!-- QR Code do Pix para o passageiro pagar. -->
        <activity
            android:name=".PixActivity"
            android:exported="false"
            android:label="Cobrar no Pix" />

        <!-- Assinatura do recibo: com o dedo (tela deitada) ou foto do papel. -->
        <activity
            android:name=".AssinaturaActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="Assinatura" />

        <!-- Entrega o PDF do recibo ao app de e-mail ou ao WhatsApp, só com permissão dada no envio. -->
        <provider
            android:name=".ArquivosProvider"
            android:authorities="app.corridaverde.arquivos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Botão "Indo pra casa" da notificação. -->
        <receiver
            android:name=".CasaReceiver"
            android:exported="false" />

        <receiver
            android:name=".ResultadoInstalacao"
            android:exported="false" />
    </application>
</manifest>
